# ===== 记账系统配置文件 =====
# 复制此文件为 .env 并根据需要修改：
#   cp .env.example .env
# 或者运行交互式配置向导：
#   npm run setup

# ===== 服务端 =====
PORT=3000
UPLOADS_DIR=uploads
BIND_ADDRESS=0.0.0.0
# 留空则自动生成随机密钥
SESSION_SECRET=
SESSION_MAX_AGE_MS=604800000

# ===== 品牌信息 =====
APP_NAME=账簿
APP_SHORT_NAME=账簿
APP_TAGLINE=财务管理系统
APP_DESCRIPTION=轻量级企业财务管理系统，支持收支录入、票据管理、工资核算、报表导出
COMPANY_NAME=凤鸣
HTML_TITLE=账簿 · 财务管理系统
HTML_LANG=zh-CN
FONT_FAMILY='PingFang SC', -apple-system, 'Helvetica Neue', 'Microsoft YaHei', sans-serif
LOCALE=zh-CN

# 登录页文案
LOGIN_HEADLINE=精准记录，<br>清晰决策
LOGIN_SUBTEXT=收支管理 · 票据追踪 · 财务报表<br>为您的团队提供专业财务管理工具
LOGIN_TITLE=登录
LOGIN_SUBTITLE=请输入您的账号信息

# ===== 地区 / 社保政策 =====
CITY_NAME=惠州
CITY_PROVINCE=广东省
SS_YEAR=2026

# 社保费率（广东惠州 2026 年基准）
SS_PENSION_PERSONAL=0.08
SS_PENSION_COMPANY=0.14
SS_MEDICAL_PERSONAL=0.02
SS_MEDICAL_COMPANY=0.065
SS_UNEMPLOYMENT_PERSONAL=0.002
SS_UNEMPLOYMENT_COMPANY=0.005
SS_INJURY_COMPANY=0.002
SS_MATERNITY_COMPANY=0.0

# ===== 税务政策 =====
# 月度免征额（元）
TAX_EXEMPTION=5000
# 七级累进税率表（JSON）
TAX_BRACKETS_JSON=[{"threshold":80000,"rate":0.45,"deduction":15160},{"threshold":55000,"rate":0.35,"deduction":7160},{"threshold":35000,"rate":0.30,"deduction":4410},{"threshold":25000,"rate":0.25,"deduction":2660},{"threshold":12000,"rate":0.20,"deduction":1410},{"threshold":3000,"rate":0.10,"deduction":210},{"threshold":0,"rate":0.03,"deduction":0}]

# ===== 默认管理员 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=管理员
MANAGER_DEFAULT_PASSWORD=manager123

# ===== 种子数据 =====
# 设为 false 跳过所有种子数据（纯手工配置）
SEED_ON_FIRST_RUN=true

# 业务线: code:name:color:sort_order 为一组，分号分隔
SEED_BUSINESS_LINES=main:主营业务:#2e7d32:1;secondary:辅助业务:#1565c0:2;project:项目业务:#e65100:3;common:公司公共:#757575:4

# 收入类目（逗号分隔）
SEED_INCOME_CATEGORIES=主营业务收入,服务收入,产品销售收入,项目收入,活动收入,其他收入

# 支出类目（逗号分隔）
SEED_EXPENSE_CATEGORIES=原材料采购,商品采购,项目物资,人力成本,水电费,办公耗材,设备维修,租金,运输费,市场推广,其他支出

# 默认负责人账号: name:username:business_line 为一组，分号分隔；留空跳过
SEED_MANAGERS=茶饮店负责人:chadian:tea;小火车负责人:huoche:train;泥鳅项目负责人:niqiu:fishing;活动承接负责人:huodong:events

# ===== 支付方式（逗号分隔）=====
PAYMENT_METHODS=现金,微信支付,支付宝,农商支付,银行转账,混合

# ===== 票据类型（逗号分隔）=====
TICKET_TYPES=增值税专用发票,增值税普通发票,收据,无票

# ===== 专项附加扣除类型（name:amount 对，逗号分隔）=====
SPECIAL_DEDUCTION_TYPES=子女教育:2000,继续教育:400,住房贷款利息:1000,住房租金:800,赡养老人:2000

# ===== 数据库 =====
DB_PATH=db/accounting.db
